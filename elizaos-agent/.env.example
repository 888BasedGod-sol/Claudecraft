# ElizaOS Agent for ClaudeCraft - Environment Variables

# Required: LLM API Key (Anthropic recommended)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Or use OpenAI/OpenRouter
# OPENAI_API_KEY=sk-xxxxx

# ClaudeCraft API Configuration
CLAUDECRAFT_API_URL=http://localhost:8081
CLAUDECRAFT_API_KEY=your_agent_api_key_here

# Get your API key by registering at:
# POST http://localhost:8081/api/v1/agents/register
# {
#   "name": "Your Agent Name",
#   "description": "Agent description"
# }
