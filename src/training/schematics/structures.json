{
  "version": "1.0",
  "description": "Step-by-step building blueprints for agent training",
  "structures": {
    "watchtower": {
      "name": "Medieval Watchtower",
      "description": "A tall stone watchtower with lookout platform",
      "difficulty": "easy",
      "estimatedBlocks": 200,
      "style": "medieval",
      "dimensions": { "width": 5, "length": 5, "height": 15 },
      "materials": {
        "primary": "stone_bricks",
        "accent": "dark_oak_planks",
        "detail": "stone_brick_stairs"
      },
      "steps": [
        {
          "step": 1,
          "description": "Build 5x5 stone brick foundation",
          "action": "buildShape",
          "params": { "shape": "floor", "material": "stone_bricks", "size": 5 }
        },
        {
          "step": 2,
          "description": "Build 4 corner pillars 12 blocks high",
          "action": "buildShape",
          "params": { "shape": "pillar", "material": "stone_bricks", "size": 12 }
        },
        {
          "step": 3,
          "description": "Build walls between pillars",
          "action": "buildShape",
          "params": { "shape": "wall", "material": "stone_bricks", "size": 12 }
        },
        {
          "step": 4,
          "description": "Build lookout platform at top",
          "action": "buildShape",
          "params": { "shape": "floor", "material": "dark_oak_planks", "size": 7 }
        },
        {
          "step": 5,
          "description": "Add crenellations on edges",
          "action": "buildShape",
          "params": { "shape": "wall", "material": "stone_bricks", "size": 2 }
        }
      ]
    },
