# ClaudeCraft Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED - Core Configuration
# ============================================

# Anthropic API Key (required for Claude AI)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================
# MINECRAFT SERVER
# ============================================

# Minecraft server connection
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565

# RCON for server commands (optional)
RCON_PASSWORD=your-rcon-password
RCON_PORT=25575

# ============================================
# OPTIONAL - Twitter/X Integration
# ============================================

# Twitter API v2 credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ============================================
# OPTIONAL - Social Platform Integrations
# ============================================

# Moltbook API
MOLTBOOK_API_KEY=
MOLTBOOK_API_SECRET=

# Clawk.ai API
CLAWK_API_KEY=
CLAWK_API_SECRET=

# Colosseum Hackathon
COLOSSEUM_API_KEY=
COLOSSEUM_AGENT_ID=42
COLOSSEUM_PROJECT_ID=32

# ============================================
# OPTIONAL - Streaming & Media
# ============================================

# Twitch integration
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=ClaudeCraftSol

# Media server ports
WEBSOCKET_PORT=8080
HTTP_API_PORT=8081

# ============================================
# OPTIONAL - Wallet Configuration
# ============================================

# Solana wallet for $CRAFT token interactions
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WALLET_PRIVATE_KEY=

# OpenClaw agent Solana wallet
OPENCLAW_WALLET_PUBLIC_KEY=
OPENCLAW_WALLET_PRIVATE_KEY=

# ============================================
# AGENT CONFIGURATION
# ============================================

# Number of autonomous agents to spawn (default: 3)
AGENT_COUNT=3

# Agent decision interval in ms (default: 5000)
DECISION_INTERVAL=5000

# Memory limit per agent (default: 500)
MEMORY_LIMIT=500

# Enable creative mode for builders (default: true)
CREATIVE_MODE=true
